# Copy file này thành .env.local và điền thông tin từ Firebase Console
# (Project Settings -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# (Tùy chọn) Giới hạn chỉ cho đúng 1 email này đăng nhập vào app
VITE_ALLOWED_EMAIL=

# (Tùy chọn) Lưu ảnh chụp Vẽ / Đi bơi / Trang sách trực tiếp lên Cloudinary
# Bạn cũng có thể nhập trực tiếp Cloud Name & Upload Preset ngay trong mục Archive & Settings của app
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=noetrix
