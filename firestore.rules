rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Khóa chặt dữ liệu cho từng tài khoản cá nhân.
    // MẸO BẢO MẬT TUYỆT ĐỐI (1 mình bạn dùng):
    // Thay YOUR_EMAIL@gmail.com bằng email Google của bạn và bỏ comment dòng check email bên dưới!
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
        // && request.auth.token.email == 'YOUR_EMAIL@gmail.com';
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
